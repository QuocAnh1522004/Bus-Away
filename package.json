{
  "name": "bus-away-playable",
  "version": "0.1.0",
  "private": true,
  "description": "Bus Away playable ad - Three.js, single-file HTML build",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/pack.mjs && node tools/report-size.mjs",
    "build:level2": "vite build --mode level2 && node tools/pack.mjs dist-level2 && node tools/report-size.mjs dist-level2",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/build-assets.mjs",
    "build:raw": "vite build && node tools/report-size.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "fbx2gltf": "^0.9.7-p1",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
